{

  "compilerOptions": {
    // File Layout
    "rootDir": "./ts",
    "outDir": "./dist",

    // Environment Settings
    "module": "ES2022",
    "target": "ES2022",
    "types": [],

    "lib": ["ES2022", "DOM"],


    // Other Outputs
    "sourceMap": true,
    "declaration": false,
    "declarationMap": false,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,


    // Recommended Options
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
  }
}
